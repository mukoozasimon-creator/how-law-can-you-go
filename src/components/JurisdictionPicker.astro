---

<div class="jurisdiction-picker" style="margin:20px 0;padding:16px 20px;background:var(--card);border:1px solid var(--rule);border-radius:2px;">
  <label style="display:block;font-family:ui-sans-serif,system-ui,sans-serif;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);margin-bottom:8px;font-weight:700;">
    Your jurisdiction
  </label>
  <select id="state-select" style="padding:10px 14px;font-size:15px;border:1px solid var(--rule);border-radius:3px;background:#fff;color:var(--ink);width:100%;max-width:300px;font-family:ui-sans-serif,system-ui,sans-serif;cursor:pointer;">
    <option value="">Select your state</option>
    {states.map(s => <option value={s.code}>{s.name}</option>)}
  </select>
  <p id="jurisdiction-msg" style="margin-top:8px;font-size:13px;color:var(--mute);font-family:ui-sans-serif,system-ui,sans-serif;display:none;"></p>
</div>

<script>
  (function() {
    const select = document.getElementById('state-select');
    const msg = document.getElementById('jurisdiction-msg');
    const saved = localStorage.getItem('hlcyg_state');

    if (saved) {
      select.value = saved;
      msg.textContent = 'Showing laws for ' + select.options[select.selectedIndex].text;
      msg.style.display = 'block';
      filterEntries(saved);
    }

    select.addEventListener('change', function() {
      const code = this.value;
      if (!code) return;
      localStorage.setItem('hlcyg_state', code);
      msg.textContent = 'Showing laws for ' + this.options[this.selectedIndex].text;
      msg.style.display = 'block';
      filterEntries(code);
    });

    function filterEntries(code) {
      document.querySelectorAll('[data-states]').forEach(el => {
        const states = el.dataset.states.split(',');
        if (states.includes(code)) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    }
  })();
</script>